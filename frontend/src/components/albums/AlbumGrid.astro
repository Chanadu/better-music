---
import AlbumGridItem from './AlbumGridItem.astro';

interface Props {
	mode: 'rated' | 'unrated';
}

const { mode } = Astro.props;
---

<div class='block' data-album-grid data-mode={mode}>
	<div class='divider mt-2 mb-0' data-album-divider></div>
	<div class='text-base-content/60 mt-4 px-2' data-album-status>Loading albums...</div>

	<div class:list={[{ 'mt-4': mode === 'unrated' }]} data-album-groups></div>

	<template data-album-card-template>
		<AlbumGridItem />
	</template>

	<template data-album-group-template>
		<section class='pt-0 pb-2'>
			<div class='divider divider-center divider-primary text-xl' data-album-group-heading></div>
			<div class='grid grid-cols-3 gap-3 px-2 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6' data-album-group-grid>
			</div>
		</section>
	</template>
</div>

<script>
	import { onDatabaseData, type Album, type Artist, type DatabaseData } from '../../scripts/database';

	type AlbumItem = {
		album: Album;
		artist?: Artist;
	};

	document.querySelectorAll<HTMLElement>('[data-album-grid]').forEach((root) => {
		const mode = root.dataset.mode === 'rated' ? 'rated' : 'unrated';

		const groups = root.querySelector<HTMLElement>('[data-album-groups]');
		const status = root.querySelector<HTMLElement>('[data-album-status]');
		const divider = root.querySelector<HTMLElement>('[data-album-divider]');
		const searchInput = document.querySelector<HTMLInputElement>('input[type="search"]');
		let latestData: DatabaseData | null = null;

		const createAlbumCard = ({ album, artist }: AlbumItem) => {
			const template = root.querySelector<HTMLTemplateElement>('[data-album-card-template]');
			const card = template?.content.firstElementChild?.cloneNode(true) as HTMLElement | undefined;

			if (!card) {
				const missingCard = document.createElement('div');
				missingCard.textContent = album.title;
				return missingCard;
			}

			const thumbnail = card.querySelector<HTMLElement>('[data-media-thumbnail]');
			const title = card.querySelector<HTMLElement>('[data-album-title]');
			const artistName = card.querySelector<HTMLElement>('[data-album-artist]');

			thumbnail?.setAttribute('image-url', album.cover_url ?? '');
			thumbnail?.setAttribute('label', album.title);
			thumbnail?.setAttribute('alt', `${album.title} cover`);

			if (title) title.textContent = album.title;
			if (artistName) artistName.textContent = artist?.name ?? 'Unknown Artist';
			return card;
		};

		const createAlbumGroup = (albums: AlbumItem[], rating?: number) => {
			const template = root.querySelector<HTMLTemplateElement>('[data-album-group-template]');
			const group = template?.content.firstElementChild?.cloneNode(true) as HTMLElement | undefined;

			if (!group) {
				const missingGroup = document.createElement('section');
				missingGroup.className = 'text-base-content/60';
				missingGroup.textContent = 'Album group template is missing.';
				return missingGroup;
			}

			const heading = group.querySelector<HTMLElement>('[data-album-group-heading]');
			const grid = group.querySelector<HTMLElement>('[data-album-group-grid]');
			if (heading) {
				if (typeof rating === 'number') {
					heading.textContent = `${rating}/10 • ${albums.length} ${albums.length === 1 ? 'album' : 'albums'}`;
				} else {
					heading.remove();
				}
			}
			grid?.append(...albums.map(createAlbumCard));
			return group;
		};

		const render = () => {
			if (!groups || !latestData) return;

			const query = searchInput?.value.trim().toLowerCase() ?? '';
			const artistsById = new Map(latestData.artists.map((artist) => [artist.id, artist]));
			const albums = latestData.albums
				.filter((album) => (typeof album.rating === 'number') === (mode === 'rated'))
				.map((album) => ({ album, artist: artistsById.get(album.artist_id) }))
				.filter(({ album, artist }) => {
					return (
						album.title.toLowerCase().includes(query) || (artist?.name.toLowerCase() ?? '').includes(query)
					);
				});

			groups.replaceChildren();
			if (albums.length === 0) {
				groups.hidden = mode === 'rated';
				if (divider) divider.hidden = false;
				if (status) {
					status.textContent = query ? `No ${mode} albums match your search.` : `No ${mode} albums yet.`;
					status.hidden = false;
				}
				return;
			}

			groups.hidden = false;
			if (divider) divider.hidden = mode === 'rated';
			if (status) status.hidden = true;

			albums.sort((first, second) => first.album.title.localeCompare(second.album.title));

			if (mode === 'unrated') {
				groups.append(createAlbumGroup(albums));
				return;
			}

			const albumsByRating = new Map<number, AlbumItem[]>();
			albums.forEach((item) => {
				const rating = item.album.rating ?? 0;
				albumsByRating.set(rating, [...(albumsByRating.get(rating) ?? []), item]);
			});

			const ratings = [...albumsByRating.keys()].sort((first, second) => second - first);
			groups.append(...ratings.map((rating) => createAlbumGroup(albumsByRating.get(rating) ?? [], rating)));
		};

		onDatabaseData((data) => {
			latestData = data;
			render();
		});
		searchInput?.addEventListener('input', render);
	});
</script>
