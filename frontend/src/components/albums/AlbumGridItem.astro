---
import MediaThumbnail from '../common/MediaThumbnail.astro';

interface Props {
	name?: string;
	imageUrl?: string;
	artistName?: string;
}

const { name = '', imageUrl, artistName = '' } = Astro.props;
---

<div class='min-w-0'>
	<MediaThumbnail variant='card' {imageUrl} label={name} alt={`${name} cover`} />
	<div class='mt-2 text-xs font-semibold text-wrap wrap-break-word' data-album-title>{name}</div>
	<div class='text-base-content/60 text-xs font-semibold text-wrap wrap-break-word' data-album-artist>
		{artistName}
	</div>
</div>
