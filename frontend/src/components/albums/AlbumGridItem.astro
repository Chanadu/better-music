---
interface Props {
	name?: string;
	imageUrl?: string;
	artistName?: string;
}

const { name = '', imageUrl, artistName = '' } = Astro.props;
const fallbackText = name.trim().charAt(0).toUpperCase() || '?';
---

<div class='min-w-0'>
	<img
		class='rounded-box aspect-square w-full object-cover'
		src={imageUrl}
		alt={imageUrl ? `${name} cover` : ''}
		data-album-cover
		hidden={!imageUrl}
	/>
	<div
		class='rounded-box bg-base-300 flex aspect-square w-full items-center justify-center text-3xl font-semibold'
		data-album-fallback
		hidden={Boolean(imageUrl)}
	>
		{fallbackText}
	</div>
	<div class='mt-2 text-xs font-semibold text-wrap wrap-break-word' data-album-title>{name}</div>
	<div class='text-base-content/60 text-xs font-semibold text-wrap wrap-break-word' data-album-artist>
		{artistName}
	</div>
</div>
