---
import MediaThumbnail from '../common/MediaThumbnail.astro';
import SearchBar from '../nav/SearchBar.astro';

interface Props {
	type: 'artist' | 'album';
}

const { type } = Astro.props;
const resultCount = type === 'artist' ? 5 : 3;
---

<div role='tabpanel' class='tab-content px-2 pt-4' data-spotify-search data-spotify-search-type={type}>
	<SearchBar placeholder={`${type} name...`} />

	<ul class='list bg-base-200 rounded-box mt-4 shadow-md' data-spotify-results>
		{
			Array.from({ length: resultCount }, () => (
				<li class='p-0' data-spotify-result>
					<label class='block cursor-default'>
						<input type='radio' name={`spotify_${type}`} class='peer sr-only' disabled />
						<div class='list-row hover:bg-base-300/50 peer-checked:bg-primary peer-checked:text-primary-content peer-checked:hover:bg-primary peer-checked:hover:text-primary-content items-center'>
							<MediaThumbnail variant='result' alt='' fallbackText='' />
							<div class='min-w-0'>
								<span data-spotify-row-loading class='loading loading-dots loading-md' hidden />
								<div data-spotify-name class='text-base-content/35 truncate'>
									Start searching...
								</div>
								<div data-spotify-meta class='text-base-content/35 truncate text-xs' />
							</div>
						</div>
					</label>
				</li>
			))
		}
	</ul>
</div>

<script>
	import { spotifyApi } from '../../scripts/api';
	import type { SpotifyAlbumSearchResult, SpotifyArtistSearchResult } from '../../scripts/api-types';

	type SearchType = 'artist' | 'album';
	type RowData = {
		id: string;
		name: string;
		meta?: string;
		imageUrl?: string;
		artistId?: string;
		artistName?: string;
		releaseYear?: string;
		disabled?: boolean;
	};

	const toArtistRow = (artist: SpotifyArtistSearchResult): RowData => ({
		id: artist.id,
		name: artist.name,
		imageUrl: artist.images[0]?.url,
	});

	const toAlbumRow = (album: SpotifyAlbumSearchResult): RowData => {
		const releaseYear = album.release_date.split('-')[0];
		const artistNames = album.artists.map((artist) => artist.name).join(', ');

		return {
			id: album.id,
			name: album.name,
			meta: [artistNames, releaseYear].filter(Boolean).join(' • '),
			imageUrl: album.images[0]?.url,
			artistId: album.artists[0]?.id,
			artistName: album.artists[0]?.name,
			releaseYear,
		};
	};

	const searchSpotify = async (type: SearchType, query: string, limit: number) =>
		type === 'artist' ?
			(await spotifyApi.searchArtists(query, limit)).map(toArtistRow)
		:	(await spotifyApi.searchAlbums(query, limit)).map(toAlbumRow);

	document.querySelectorAll<HTMLElement>('[data-spotify-search]').forEach((section) => {
		const type = section.dataset.spotifySearchType as SearchType;
		const searchInput = section.querySelector<HTMLInputElement>('input[type="search"]');
		const resultsList = section.querySelector<HTMLUListElement>('[data-spotify-results]');
		const rows = Array.from(section.querySelectorAll<HTMLLIElement>('[data-spotify-result]'));
		let searchTimeout: number | undefined;
		let latestRequest = 0;
		let selected: RowData | undefined;

		const updateRow = (row: HTMLLIElement, data: RowData) => {
			const {
				id,
				name,
				meta = '',
				imageUrl,
				artistId = '',
				artistName = '',
				releaseYear = '',
				disabled = false,
			} = data;
			const label = row.querySelector<HTMLLabelElement>('label');
			const input = row.querySelector<HTMLInputElement>('input[type="radio"]');
			const thumbnail = row.querySelector<HTMLElement>('[data-media-thumbnail]');
			const nameElement = row.querySelector<HTMLElement>('[data-spotify-name]');
			const metaElement = row.querySelector<HTMLElement>('[data-spotify-meta]');

			Object.assign(row.dataset, {
				spotifyId: id,
				spotifyName: name,
				spotifyImageUrl: imageUrl ?? '',
				spotifyArtistId: artistId,
				spotifyArtistName: artistName,
				spotifyReleaseYear: releaseYear,
			});

			if (input) {
				input.value = id;
				input.disabled = disabled;
				input.checked = selected?.id === id && !disabled;
				input.onclick = () => {
					if (selected?.id !== id) return;
					selected = undefined;
					input.checked = false;
					input.dispatchEvent(new Event('change', { bubbles: true }));
				};
			}

			label?.classList.toggle('cursor-pointer', !disabled);
			label?.classList.toggle('cursor-default', disabled);

			thumbnail?.setAttribute('image-url', imageUrl ?? '');
			thumbnail?.setAttribute('label', name);
			thumbnail?.setAttribute('alt', `${name} ${type} image`);
			if (disabled) {
				thumbnail?.setAttribute('fallback-text', '');
			} else {
				thumbnail?.removeAttribute('fallback-text');
			}

			if (nameElement) nameElement.textContent = name;
			if (metaElement) metaElement.textContent = meta;
			[nameElement, metaElement].forEach((element) =>
				element?.classList.toggle('text-base-content/35', disabled),
			);
		};

		const keepSelectionVisible = (index: number) => {
			if (selected && !rows.some((row) => row.dataset.spotifyId === selected?.id)) {
				const row = rows[index];
				if (row) updateRow(row, selected);
			}
		};

		const setLoading = (isLoading: boolean) => {
			resultsList?.setAttribute('aria-busy', String(isLoading));
			rows.forEach((row) => {
				const loadingIndicator = row.querySelector<HTMLElement>('[data-spotify-row-loading]');
				const nameElement = row.querySelector<HTMLElement>('[data-spotify-name]');
				const metaElement = row.querySelector<HTMLElement>('[data-spotify-meta]');

				if (loadingIndicator) loadingIndicator.hidden = !isLoading;
				if (nameElement) nameElement.hidden = isLoading;
				if (metaElement) metaElement.hidden = isLoading;
			});
		};

		const renderLoading = () => {
			rows.forEach((row, index) => updateRow(row, { id: `loading-${index}`, name: '', disabled: true }));
			setLoading(true);
		};

		const renderMessage = (message: string) => {
			setLoading(false);
			rows.forEach((row, index) => updateRow(row, { id: `placeholder-${index}`, name: message, disabled: true }));
			keepSelectionVisible(0);
		};

		const renderResults = (results: RowData[]) => {
			setLoading(false);
			const visibleResults =
				selected && !results.some(({ id }) => id === selected?.id) ? results.slice(0, -1) : results;
			rows.forEach((row, index) =>
				updateRow(row, visibleResults[index] ?? { id: `empty-${index}`, name: '', disabled: true }),
			);
			keepSelectionVisible(rows.length - 1);
		};

		const runSearch = async () => {
			const query = searchInput?.value.trim() ?? '';
			const requestId = ++latestRequest;
			if (!query) return renderMessage('Start searching...');

			renderLoading();
			try {
				const results = await searchSpotify(type, query, rows.length);
				if (requestId !== latestRequest) return;
				results.length ? renderResults(results) : renderMessage(`No ${type}s found.`);
			} catch {
				if (requestId === latestRequest) renderMessage('Spotify search failed.');
			}
		};

		searchInput?.addEventListener('input', () => {
			window.clearTimeout(searchTimeout);
			searchTimeout = window.setTimeout(runSearch, 250);
		});

		resultsList?.addEventListener('change', (event) => {
			const input = event.target;
			if (!(input instanceof HTMLInputElement) || input.name !== `spotify_${type}`) return;
			if (!input.checked) return void (selected = undefined);

			const row = input.closest<HTMLLIElement>('[data-spotify-result]');
			if (!row || input.disabled) return;
			selected = {
				id: row.dataset.spotifyId ?? input.value,
				name: row.dataset.spotifyName ?? '',
				imageUrl: row.dataset.spotifyImageUrl || undefined,
				artistId: row.dataset.spotifyArtistId || undefined,
				artistName: row.dataset.spotifyArtistName || undefined,
				releaseYear: row.dataset.spotifyReleaseYear || undefined,
				meta: row.querySelector<HTMLElement>('[data-spotify-meta]')?.textContent ?? '',
			};
		});

		document.addEventListener('spotify-search-reset', () => {
			window.clearTimeout(searchTimeout);
			latestRequest++;
			selected = undefined;
			if (searchInput) searchInput.value = '';
			renderMessage('Start searching...');
		});

		renderMessage('Start searching...');
	});
</script>
