---
import MediaThumbnail from '../../common/MediaThumbnail.astro';
import FloatingInput from '../../FloatingInput.astro';
---

<div role='tabpanel' class='tab-content px-2 pt-4'>
	<div class='flex flex-col gap-3'>
		<FloatingInput label='Artist Name'>
			<input data-manual-artist-name-input type='text' class='input w-full' placeholder='e.g. J. Cole' />
		</FloatingInput>

		<div class='flex justify-center'>
			<MediaThumbnail variant='artist-preview' label='' alt='' emptyFallback='' dataId='manual-artist-preview' />
		</div>
	</div>
</div>

<script>
	const manualArtistNameInput = document.querySelector<HTMLInputElement>('[data-manual-artist-name-input]');
	const manualArtistPreview = document.querySelector<HTMLElement>('[data-thumbnail-id="manual-artist-preview"]');

	const updateManualArtistPreview = () => {
		const name = manualArtistNameInput?.value.trim() ?? '';
		manualArtistPreview?.setAttribute('label', name);
		manualArtistPreview?.setAttribute('alt', name ? `${name} artist preview` : '');
	};

	manualArtistNameInput?.addEventListener('input', updateManualArtistPreview);
	updateManualArtistPreview();
</script>
