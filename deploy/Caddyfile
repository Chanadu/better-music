:8081 {
    encode gzip zstd

    handle /api/* {
        reverse_proxy 127.0.0.1:8080
    }

    handle /_app/* {
        root * /home/pi/better-music/frontend/build
        file_server
    }

    handle {
        root * /home/pi/better-music/frontend/build
        header Cache-Control "no-cache"
        try_files {path} /200.html
        file_server
    }
}
